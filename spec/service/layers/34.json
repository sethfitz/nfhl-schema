      "valueExpression": "if(Trim(Lower($feature.OUTCOME)) == \"denied\" \n|| Trim(Lower($feature.OUTCOME)) == \"denied-in floodway\" \n|| Trim(Lower($feature.OUTCOME)) == \"portion of property denied\"\n|| Trim(Lower($feature.OUTCOME)) == \"portion of property denied and in floodway\"\n|| Trim(Lower($feature.OUTCOME)) == \"property denied\"\n|| Trim(Lower($feature.OUTCOME)) == \"property denied and in floodway\"\n|| Trim(Lower($feature.OUTCOME)) == \"structure denied\"\n|| Trim(Lower($feature.OUTCOME)) == \"structure denied and in floodway\"){\n    return \"Denied\"\n}\n\nelse if(Trim(Lower($feature.REVAL_STAT)) == \"incorporated\"){\n    return \"Incorporated\"\n}\n\nelse if(Trim(Lower($feature.REVAL_STAT)) == \"superseded\"){\n    return \"Superseded\"\n}\n\nelse if(Trim(Lower($feature.REVAL_STAT)) == \"contact community\"){\n    return \"Contact Community\"\n}\n\nelse if(Trim(Lower($feature.REVAL_STAT)) == \"reevaluation needed\"){\n    return \"Reevaluation Needed\"\n}\n\nelse{\n    return \"Valid\"\n}",
