#!/usr/bin/env -S uv run python
"""Refresh spec/ from FEMA: the two technical references and the NFHL service.

Three sources, each pinned by what it is:

* The FIRM Database Technical Reference and the Domain Tables Technical Reference
  (FEMA Guidelines & Standards, November 2024 edition). The field tables and the
  coded-value vocabularies are published nowhere else. Each PDF is vendored with
  a `pdftotext -layout` rendering beside it, for grepping, and the ruled tables
  are extracted to JSON by `nfhl.extract` -- the generation source.
* The NFHL ArcGIS MapServer's own metadata: every layer and table, with its
  fields, Esri types and lengths. The service declares no coded-value domains.
* What the service holds: per-value row counts for every field of a modelled
  layer that the reference ties to a domain, per-pair counts for every two
  fields a rule reads together, per-combination counts for every field the
  model's rules read (what `scripts/count-broken-rules` judges), and the
  layer's total, from the `query` endpoint's grouped statistics. These are
  observations, not specification -- the reference is what the models
  enforce, and a value seen here but absent from the reference is a finding,
  recorded in spec/README.md.

`MANIFEST.json` records each source URL, when it was retrieved, and a SHA-256 of
every file written.

Pass `--skip-observed` to leave the observation files alone: the grouped
statistics take minutes over the full national layer. `--layer ID`, repeatable,
refreshes only those layers' observations and leaves the others' alone.
"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any

from nfhl.extract import DOMAIN_HEADING, FIRM_HEADING, extract, write
from nfhl.rule_counts import fetch_groups, rule_fields
from nfhl.service import SERVICE, fetch, fetch_json, grouped, query_url, row_count
from nfhl.spec_source import (
    DOMAIN_TABLES,
    FIRM_DATABASE,
    LAYERS,
    SPEC_DIR,
    Layer,
    SpecReader,
    layer_model,
)

# The FEMA Guidelines & Standards index this edition was found on; it links both.
INDEX = (
    "https://www.fema.gov/flood-maps/guidance-reports/guidelines-standards/"
    "technical-references-flood-risk-analysis-and-mapping"
)
REFERENCES = {
    FIRM_DATABASE: (
        "https://www.fema.gov/sites/default/files/documents/"
        "fema_rm-firm-database-technical-reference-nov-2024.pdf",
        FIRM_HEADING,
    ),
    DOMAIN_TABLES: (
        "https://www.fema.gov/sites/default/files/documents/"
        "fema_rm-domain-tables-technical-reference-nov-2024.pdf",
        DOMAIN_HEADING,
    ),
}


def dump(path: Path, payload: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(payload, indent=2, ensure_ascii=False) + "\n")


def snapshot_references(spec: Path) -> list[dict[str, str]]:
    sources = []
    for stem, (url, heading) in REFERENCES.items():
        pdf = spec / "reference" / f"{stem}.pdf"
        pdf.parent.mkdir(parents=True, exist_ok=True)
        print(f"==> {url}")
        pdf.write_bytes(fetch(url))
        if shutil.which("pdftotext"):
            subprocess.run(
                ["pdftotext", "-layout", str(pdf), str(pdf.with_suffix(".txt"))],
                check=True,
            )
        else:
            print("pdftotext not on PATH; .txt not refreshed", file=sys.stderr)
        print(f"    extracting tables from {pdf.name}")
        write(extract(pdf, heading), pdf.name, pdf.with_suffix(".json"))
        sources.append({"path": f"reference/{stem}.pdf", "url": url})
    return sources


def snapshot_service(spec: Path) -> list[dict[str, str]]:
    print(f"==> {SERVICE}")
    root = fetch_json(SERVICE, {"f": "json"})
    dump(spec / "service" / "MapServer.json", root)
    sources = [{"path": "service/MapServer.json", "url": f"{SERVICE}?f=json"}]
    for layer in [*root["layers"], *root.get("tables", [])]:
        url = f"{SERVICE}/{layer['id']}"
        dump(
            spec / "service" / "layers" / f"{layer['id']}.json",
            fetch_json(url, {"f": "json"}),
        )
        sources.append(
            {"path": f"service/layers/{layer['id']}.json", "url": f"{url}?f=json"}
        )
    return sources


def snapshot_observed(spec: Path, layers: list[Layer]) -> list[dict[str, str]]:
    reader = SpecReader(spec)
    sources = []
    for layer in layers:
        url = query_url(layer.layer_id)
        print(f"==> observed values, layer {layer.layer_id}")
        total = row_count(layer.layer_id)
        fields: dict[str, list[dict[str, Any]]] = {}
        for field in reader.reference_table(layer.table).fields:
            if field.domain is None or field.name not in reader.service_fields(layer):
                continue
            print(f"    {field.name}")
            rows = grouped(layer.layer_id, [field.name])
            fields[field.name] = sorted(
                ({"value": r[field.name], "count": r["n"]} for r in rows),
                key=lambda r: (-r["count"], str(r["value"])),
            )
        # Every pair of fields a rule reads together, counted per value pair,
        # so a rule's violations can be counted from the snapshot.
        combinations: dict[str, list[dict[str, Any]]] = {}
        for when, field_name in sorted(
            {(r.when, r.field) for r in reader.pair_rules(layer.table)}
        ):
            print(f"    {when} x {field_name}")
            rows = grouped(layer.layer_id, [when, field_name])
            combinations[f"{when},{field_name}"] = sorted(
                (
                    {when: r[when], field_name: r[field_name], "count": r["n"]}
                    for r in rows
                ),
                key=lambda r: (-r["count"], str(r[when]), str(r[field_name])),
            )
        print("    every field the rules read")
        read_by_rules = rule_fields(layer_model(layer))
        groups = fetch_groups(layer.layer_id, read_by_rules)
        dump(
            spec / "service" / "observed" / f"{layer.layer_id}.json",
            {
                "layer": layer.layer_id,
                "total": total,
                "fields": fields,
                "combinations": combinations,
                "rules": {
                    "by_value": read_by_rules.by_value,
                    "by_populated": read_by_rules.by_populated,
                    "by_text_populated": read_by_rules.by_text_populated,
                    "groups": groups,
                },
            },
        )
        sources.append(
            {
                "path": f"service/observed/{layer.layer_id}.json",
                "url": f"{url}?groupByFieldsForStatistics=<field>&outStatistics=count",
            }
        )
    return sources


def checksums(spec: Path) -> list[dict[str, Any]]:
    # Local readings, not upstream: they change without a fetch.
    skip = {
        "MANIFEST.json",
        "README.md",
        "repairs.json",
        "relationships.json",
        "legacy.json",
    }
    files = sorted(p for p in spec.rglob("*") if p.is_file() and p.name not in skip)
    return [
        {
            "path": str(p.relative_to(spec)),
            "sha256": hashlib.sha256(p.read_bytes()).hexdigest(),
            "bytes": p.stat().st_size,
        }
        for p in files
    ]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--skip-observed", action="store_true")
    parser.add_argument("--layer", type=int, action="append", default=[])
    args = parser.parse_args()
    unknown = set(args.layer) - {lyr.layer_id for lyr in LAYERS}
    if unknown:
        parser.error(f"not a modelled layer: {sorted(unknown)}")
    layers = (
        []
        if args.skip_observed
        else [lyr for lyr in LAYERS if not args.layer or lyr.layer_id in args.layer]
    )
    refreshed = {f"service/observed/{lyr.layer_id}.json" for lyr in layers}

    spec = SPEC_DIR
    manifest_path = spec / "MANIFEST.json"
    previous = json.loads(manifest_path.read_text()) if manifest_path.exists() else {}
    now = dt.datetime.now(dt.UTC).strftime("%Y-%m-%dT%H:%M:%SZ")

    sources = [*snapshot_references(spec), *snapshot_service(spec)]
    retrieved = {s["path"]: now for s in sources}
    kept = [
        s
        for s in previous.get("sources", [])
        if s["path"].startswith("service/observed/") and s["path"] not in refreshed
    ]
    observed = snapshot_observed(spec, layers)
    sources += sorted([*kept, *observed], key=lambda s: s["path"])
    retrieved |= {s["path"]: s["retrieved_at"] for s in kept}
    retrieved |= {s["path"]: now for s in observed}

    manifest = {
        "edition": "November 2024",
        "index": INDEX,
        "sources": [{**s, "retrieved_at": retrieved[s["path"]]} for s in sources],
        "files": checksums(spec),
    }
    dump(manifest_path, manifest)
    print(f"done: {len(manifest['files'])} files in {spec}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
