# Every required field populated, every accuracy a reference one and every
# point a point, unless the case is about that; a lone space in free text is a
# value. `SHAPE IS NULL` matches no row, so an empty point is found by its
# missing X.
STATION_FIELDS = {
    "geometry": "SHAPE.STX IS NOT NULL",
    "START_ID": "START_ID IS NOT NULL AND START_ID <> ''",
    "START_DESC": "START_DESC IS NOT NULL",
    "SOURCE_CIT": f"NOT {missing('SOURCE_CIT')}",
    "LOC_ACC": "LOC_ACC IN ('High', 'Medium', 'Low')",
}
STATION_CASES: list[Case] = [
    ("high_accuracy", "LOC_ACC = 'High'", None, None),
    ("medium_accuracy", "LOC_ACC = 'Medium'", None, None),
    ("low_accuracy", "LOC_ACC = 'Low'", None, None),
    ("lone_space_source_citation", "SOURCE_CIT LIKE ' '", None, None),
    # A legacy value (spec/legacy.json), which validates with a warning.
    ("not_populated_accuracy", "LOC_ACC = 'NP'", None, "LOC_ACC"),
    # Findings: published station starts the reference does not allow. Each
    # case names one field, so a missing START_ID makes none: all 198 rows
    # without one also lack START_DESC or SOURCE_CIT.
    ("no_start_description", "START_DESC IS NULL", "START_DESC", None),
    ("no_source_citation", missing("SOURCE_CIT"), "SOURCE_CIT", None),
    ("no_accuracy", "LOC_ACC IS NULL", "LOC_ACC", None),
    ("empty_point", "SHAPE.STX IS NULL", "geometry", None),
]


FIXTURES_BY_LAYER = [
    Fixture(28, "flood_hazard_zones.json", ZONE_CASES, zone_filters),
    Fixture(
        16,
        "base_flood_elevations.json",
        BFE_CASES,
        clean_except_expected(BFE_FIELDS, BFE_CASES, BFE_SPARSE),
    ),
    Fixture(
        14,
        "cross_sections.json",
        XS_CASES,
        clean_except_expected(XS_FIELDS, XS_CASES, XS_SPARSE),
    ),
    Fixture(
        17,
        "profile_baselines.json",
        PROFILE_CASES,
        clean_except_expected(PROFILE_FIELDS, PROFILE_CASES, PROFILE_SPARSE),
    ),
    Fixture(
        13,
        "station_starts.json",
        STATION_CASES,
        clean_except_expected(STATION_FIELDS, STATION_CASES, set(), short=None),
    ),
]


def query(layer: int, where: str) -> dict[str, Any]:
    try:
        payload: dict[str, Any] = fetch_json(
            query_url(layer),
            {
                "where": where,
                "outFields": "*",
                "resultRecordCount": "1",
                "f": "geojson",
            },
        )
    except RuntimeError as e:
        raise RuntimeError(f"{where}: {e}") from e
    return payload


def fetch_fixture(fixture: Fixture) -> bool:
    """Write `fixture`'s file; whether every case found a feature."""
    cases = []
    for name, where, expect, warns in fixture.cases:
        full = f"({where}) AND {fixture.filters(name)}"
        print(f"==> {name}")
        features = query(fixture.layer, full)["features"]
        if not features:
            print(f"    no feature matches; skipped: {full}", file=sys.stderr)
            continue
        cases.append(
            {
                "name": name,
                "where": full,
                "expect": expect,
                "warns": warns,
                "feature": features[0],
            }
        )
    payload = {
        "source": query_url(fixture.layer),
        "retrieved_at": dt.datetime.now(dt.UTC).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "cases": cases,
    }
    out = FIXTURES / fixture.out
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(payload, indent=2, ensure_ascii=False) + "\n")
    print(f"wrote {len(cases)} of {len(fixture.cases)} cases to {out}")
    return len(cases) == len(fixture.cases)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--layer", type=int, action="append", default=[], help="only these layers"
    )
    args = parser.parse_args()
    complete = [
        fetch_fixture(f)
        for f in FIXTURES_BY_LAYER
        if not args.layer or f.layer in args.layer
    ]
    return 0 if all(complete) else 1


if __name__ == "__main__":
    sys.exit(main())
