    # rule that limits it to Non-Accredited levees.
    ("not_populated_status", "LEVEE_STAT = 'NP' AND LEV_AN_TYP = 'NP'", None, None),
    # 7.3's non-populated number, in a freeboard with a unit.
    ("not_populated_freeboard", "FREEBOARD = -8888 AND LEN_UNIT = 'Feet'", None, None),
    # Legacy values (spec/legacy.json), which validate with a warning.
    ("de_accredited", "LEVEE_STAT = 'De-Accredited'", None, "LEVEE_STAT"),
    ("never_accredited", "LEVEE_STAT = 'Never Accredited'", None, "LEVEE_STAT"),
    # Findings: published levees the reference does not allow. Each case names
    # one field, so a finding in SOURCE_CIT, a coded DISTRICT, a coded or
    # lone-space LEVEE_STAT, a lone-space LEN_UNIT or a coded USACE_LEV or
    # PL84_99TF makes none: every such levee also lacks FC_SEG_ID, or breaks a
    # second field.
    ("no_segment_id", missing("FC_SEG_ID"), "FC_SEG_ID", None),
    ("no_system_id", missing("FC_SYS_ID"), "FC_SYS_ID", None),
    ("lone_space_district", "DISTRICT LIKE ' '", "DISTRICT", None),
    ("uppercase_district", "LEVEE_ID = '20079C_1'", "DISTRICT", None),
    ("uppercase_levee_type", "LEVEE_ID = '38055C_1'", "LEVEE_TYP", None),
    ("uppercase_status", "LEVEE_ID = '1505901512'", "LEVEE_STAT", None),
    ("coded_analysis", "LEV_AN_TYP = 'NV'", "LEV_AN_TYP", None),
    ("lone_space_analysis", "LEV_AN_TYP LIKE ' '", "LEV_AN_TYP", None),
    (
        "analysis_on_accredited",
        "LEVEE_STAT = 'Accredited' AND LEV_AN_TYP = 'Natural Valley'",
        "@forbid_if(lev_an_typ)",
        None,
    ),
    (
        "usace_without_district",
        f"USACE_LEV = 'T' AND {missing('DISTRICT')}",
        "@require_if(district)",
        None,
    ),
]
