    "SOURCE_CIT": "SOURCE_CIT IS NOT NULL",
    "V_DATUM": "V_DATUM NOT IN ('ASVD02', 'GUVD03', 'NGVD88')",
    **{f: f"{f} <> -9999 AND {f} IS NOT NULL" for f in ("WSEL_REG", "STRMBED_EL")},
    LETTER_RULE: "(XS_LN_TYP = 'LETTERED, MAPPED' OR XS_LTR IS NULL "
    "OR (XS_LTR = '' AND XS_LTR NOT LIKE ' '))",
}
UNLETTERED = "XS_LN_TYP = 'NOT LETTERED, MAPPED'"
