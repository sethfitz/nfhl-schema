#!/usr/bin/env -S uv run python
"""Fetch real features of each modelled layer from the NFHL service into
tests/fixtures/, one file per layer.

Each case is one feature chosen by a `where` clause, recorded beside the feature
with what the model should say about it: `expect` is `null` when it should
validate, or the wire name of the field (or rule) that should reject it; `warns`
is the wire name of a field holding a legacy value, which validates with a
`LegacyValueWarning`. The rejected and warned cases are real published features
that disagree with the technical reference -- findings, kept as fixtures so the
disagreement stays visible and tested.

Small features only (`SHAPE.STArea()` and `SHAPE.STLength()`, in degrees), so
the fixture stays reviewable. Re-running picks whatever the service returns
first today, which may be a different feature; the test reads the expectations,
not the ids.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import sys
from collections.abc import Callable
from dataclasses import dataclass
from pathlib import Path
from typing import Any

from nfhl.service import fetch_json, query_url

FIXTURES = Path(__file__).resolve().parents[1] / "tests" / "fixtures"

# (name, where, expect, warns)
type Case = tuple[str, str, str | None, str | None]


@dataclass(frozen=True, slots=True)
class Fixture:
    """One layer's cases, and the clauses added to each case's `where`."""

    layer: int
    out: str
    cases: list[Case]
    filters: Callable[[str], str]  # case name -> clauses ANDed to its `where`


# Bounding perimeter as well as area keeps the vertex count, and the diff, small.
SMALL = "SHAPE.STArea() < 0.000001 AND SHAPE.STLength() < 0.01"
# Nothing else on the feature disagrees with the reference, so the case tests
# only what it names. `IS NULL` rather than `= ''`: the service is SQL Server,
# where `' ' = ''` is true, so an empty-string test also matches a lone space --
# which the reference does not allow.
CLEAN = (
    "VELOCITY = -9999 AND VEL_UNIT IS NULL "
    "AND AR_REVERT IS NULL AND AR_SUBTRV IS NULL "
    "AND BFE_REVERT = -9999 AND DEP_REVERT = -9999 "
    "AND (DUAL_ZONE IS NULL OR DUAL_ZONE IN ('T', 'F', 'U'))"
)
# Most zone-rule findings are a few dozen rows nationally, none of them both
# small and NULL where the service could write `""`. Those take a looser bound
# and accept `= ''`, which also matches a lone space; a space would be rejected
# by its field's vocabulary, and the test asserts each case's whole rejection,
# so one would fail the case rather than pass unseen.
RARE = (
    "VELOCITY = -9999 AND (VEL_UNIT IS NULL OR VEL_UNIT = '') "
    "AND (AR_REVERT IS NULL OR AR_REVERT = '') "
    "AND (AR_SUBTRV IS NULL OR AR_SUBTRV = '') "
    "AND BFE_REVERT = -9999 AND DEP_REVERT = -9999 "
    "AND (DUAL_ZONE IS NULL OR DUAL_ZONE IN ('', 'T', 'F', 'U')) "
    "AND SHAPE.STArea() < 0.00005 AND SHAPE.STLength() < 0.05"
)
NO_BFE = "STATIC_BFE = -9999 AND V_DATUM IS NULL"
NO_DEPTH = "DEPTH = -9999 AND LEN_UNIT IS NULL"

ZONE_CASES: list[Case] = [
