SHORT = "SHAPE.STLength() < 0.01"


def clean_except_expected(
    fields: dict[str, str],
    cases: list[Case],
    sparse: set[str],
    short: str | None = SHORT,
) -> Callable[[str], str]:
    """Filters holding every field of `fields` clean but the one a case expects
    to reject or to warn, and the features `short` unless the case is sparse.
    A point has no length, so its layer passes `short=None`."""

    def filters(name: str) -> str:
        _, _, expect, warns = next(c for c in cases if c[0] == name)
        clauses = [w for f, w in fields.items() if f not in (expect, warns)]
        if short and name not in sparse:
            clauses.append(short)
        return " AND ".join(clauses)

    return filters


# Every required field populated, every vocabulary value listed, and no letter
# on an unlettered section, unless the case is about that; a lone space in free
# text is a value, so `<> ''`, which also rejects one, is the strict side.
