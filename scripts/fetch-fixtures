        None,
    ),
    (
        "ae_outside_sfha",
        "FLD_ZONE = 'AE' AND SFHA_TF = 'F'",
        "@require_any_true(sfha_tf) [A, A99, AE, AH, AO, AR, V, VE]",
        None,
    ),
    (
        "x_inside_sfha",
        "FLD_ZONE = 'X' AND SFHA_TF = 'T'",
        "@require_any_true(sfha_tf) [D, X]",
        None,
    ),
]

# The cases with too few rows to be both small and NULL-clean.
SPARSE = {
    "x_special_consideration",
    "a99_without_subtype",
    "ae_outside_sfha",
    "x_inside_sfha",
}


def zone_filters(name: str) -> str:
    return RARE if name in SPARSE else f"{CLEAN} AND {SMALL}"


# Every required field populated and in its vocabulary, unless the case is about
# that field; `IS NULL` for the text ones, where the service writes no `""`.
BFE_FIELDS = {
    "ELEV": "ELEV <> -9999 AND ELEV IS NOT NULL",
    "V_DATUM": "V_DATUM NOT IN ('ASVD02', 'GUVD03', 'NAVD29')",
    "SOURCE_CIT": "SOURCE_CIT IS NOT NULL",
    "BFE_LN_ID": "BFE_LN_ID IS NOT NULL AND BFE_LN_ID <> ''",
}
BFE_CASES: list[Case] = [
