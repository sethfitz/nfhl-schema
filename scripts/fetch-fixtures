    ),
    ("floodwall", "LEVEE_TYP = 'Floodwall' AND LEVEE_STAT = 'Accredited'", None, None),
    ("closure_structure", "LEVEE_TYP = 'Closure Structure'", None, None),
    ("coastal_levee", "LEVEE_TYP = 'Coastal Levee Centerline'", None, None),
