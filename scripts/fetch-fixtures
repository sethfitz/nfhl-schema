XS_SPARSE = {"ngvd88_datum", "no_stream_station", "no_water_surface"}


def missing(field: str) -> str:
    """`field` holds no text; a lone space is text."""
    return f"({field} IS NULL OR ({field} = '' AND {field} NOT LIKE ' '))"


def continues_without(first: str, then: str) -> str:
    """`then` holds text, a lone space included, while `first` holds none."""
    holds_text = f"({then} IS NOT NULL AND ({then} <> '' OR {then} LIKE ' '))"
    return f"{holds_text} AND {missing(first)}"


# STUDY_TYP values that are neither in D_Study_Typ nor legacy (spec/legacy.json).
STUDY_TYP_OUT_OF_DOMAIN = ["New H&H", "1050", "Profile Baseline"]
# The legacy ones, which validate with a warning.
STUDY_TYP_LEGACY = [
    "SFHAs WITH HIGH FLOOD RISK",
    "SFHAs WITH LOW FLOOD RISK",
    "SFHAs WITH MEDIUM FLOOD RISK",
    "REDELINEATION",
    "DIGITAL CONVERSION",
    "Shaded Zone X with depths less than 1'",
]


def sql_list(values: list[str]) -> str:
    return ", ".join("'" + v.replace("'", "''") + "'" for v in values)


# Every required field populated, every vocabulary value a reference one, no
# lone-space unit, and no continuation field without the one it continues,
# unless the case is about that.
PROFILE_RULES = {
    "@forbid_if(fld_prob2)": ("FLD_PROB1", "FLD_PROB2"),
    "@forbid_if(fld_prob3)": ("FLD_PROB2", "FLD_PROB3"),
    "@forbid_if(spec_cons2)": ("SPEC_CONS1", "SPEC_CONS2"),
}
PROFILE_FIELDS = {
    **{
        f: f"{f} IS NOT NULL AND {f} <> ''"
        for f in ("BASELN_ID", "WTR_NM", "SOURCE_CIT")
    },
    "WATER_TYP": f"({missing('WATER_TYP')} OR WATER_TYP IN ('Profile Baseline', "
    "'Profile Baseline and Stream Centerline', 'Hydraulic Link', 'Unknown'))",
    "STUDY_TYP": f"({missing('STUDY_TYP')} OR (STUDY_TYP NOT LIKE ' ' AND "
    f"STUDY_TYP NOT IN ({sql_list(STUDY_TYP_OUT_OF_DOMAIN + STUDY_TYP_LEGACY)})))",
    "SHOWN_FIRM": f"({missing('SHOWN_FIRM')} OR SHOWN_FIRM IN ('T', 'F', 'U'))",
    "DATUM_UNIT": "(DATUM_UNIT IS NULL OR DATUM_UNIT NOT LIKE ' ')",
    **{
        rule: f"NOT ({continues_without(first, then)})"
        for rule, (first, then) in PROFILE_RULES.items()
    },
}
