#!/usr/bin/env -S uv run python
"""Fetch real features of each modelled layer from the NFHL service into
tests/fixtures/, one file per layer.

Each case is one feature chosen by a `where` clause, recorded beside the feature
with what the model should say about it: `expect` is `null` when it should
validate, or the wire name of the field (or rule) that should reject it; `warns`
is the wire name of a field holding a legacy value, which validates with a
`LegacyValueWarning`. The rejected and warned cases are real published features
that disagree with the technical reference -- findings, kept as fixtures so the
disagreement stays visible and tested.

Small features only (`SHAPE.STArea()` and `SHAPE.STLength()`, in degrees), so
the fixture stays reviewable. Re-running picks whatever the service returns
first today, which may be a different feature; the test reads the expectations,
not the ids.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import subprocess
import sys
import urllib.parse
from collections.abc import Callable
from dataclasses import dataclass
from pathlib import Path
from typing import Any

SERVICE = "https://hazards.fema.gov/arcgis/rest/services/public/NFHL/MapServer"
FIXTURES = Path(__file__).resolve().parents[1] / "tests" / "fixtures"

# (name, where, expect, warns)
type Case = tuple[str, str, str | None, str | None]


@dataclass(frozen=True, slots=True)
class Fixture:
    """One layer's cases, and the clauses added to each case's `where`."""

    layer: int
    out: str
    cases: list[Case]
    filters: Callable[[str], str]  # case name -> clauses ANDed to its `where`


# Bounding perimeter as well as area keeps the vertex count, and the diff, small.
SMALL = "SHAPE.STArea() < 0.000001 AND SHAPE.STLength() < 0.01"
# Nothing else on the feature disagrees with the reference, so the case tests
# only what it names. `IS NULL` rather than `= ''`: the service is SQL Server,
# where `' ' = ''` is true, so an empty-string test also matches a lone space --
# which the reference does not allow.
CLEAN = (
    "VELOCITY = -9999 AND VEL_UNIT IS NULL "
    "AND AR_REVERT IS NULL AND AR_SUBTRV IS NULL "
    "AND BFE_REVERT = -9999 AND DEP_REVERT = -9999 "
    "AND (DUAL_ZONE IS NULL OR DUAL_ZONE IN ('T', 'F', 'U'))"
)
# Most zone-rule findings are a few dozen rows nationally, none of them both
# small and NULL where the service could write `""`. Those take a looser bound
# and accept `= ''`, which also matches a lone space; a space would be rejected
# by its field's vocabulary, and the test asserts each case's whole rejection,
# so one would fail the case rather than pass unseen.
RARE = (
    "VELOCITY = -9999 AND (VEL_UNIT IS NULL OR VEL_UNIT = '') "
    "AND (AR_REVERT IS NULL OR AR_REVERT = '') "
    "AND (AR_SUBTRV IS NULL OR AR_SUBTRV = '') "
    "AND BFE_REVERT = -9999 AND DEP_REVERT = -9999 "
    "AND (DUAL_ZONE IS NULL OR DUAL_ZONE IN ('', 'T', 'F', 'U')) "
    "AND SHAPE.STArea() < 0.00005 AND SHAPE.STLength() < 0.05"
)
NO_BFE = "STATIC_BFE = -9999 AND V_DATUM IS NULL"
NO_DEPTH = "DEPTH = -9999 AND LEN_UNIT IS NULL"

ZONE_CASES: list[Case] = [
    (
        "ae_static_bfe",
        "FLD_ZONE = 'AE' AND ZONE_SUBTY IS NULL "
        "AND STUDY_TYP = 'SFHA with BFE and floodway' AND STATIC_BFE > 0 "
        "AND V_DATUM = 'NAVD88' AND LEN_UNIT = 'Feet' AND DEPTH = -9999 "
        # The service compares case-insensitively, so `= 'Feet'` also matches
        # this study's `FEET`; that feature is the uppercase_len_unit case.
        "AND DFIRM_ID <> '39057C'",
        None,
        None,
    ),
    (
        "ae_floodway",
        f"FLD_ZONE = 'AE' AND ZONE_SUBTY = 'FLOODWAY' "
        f"AND STUDY_TYP = 'SFHA with BFE and floodway' AND {NO_BFE} AND {NO_DEPTH}",
        None,
        None,
    ),
    (
        "ao_depth",
        f"FLD_ZONE = 'AO' AND DEPTH > 0 AND LEN_UNIT = 'Feet' AND {NO_BFE} "
        "AND STUDY_TYP = 'NP'",
        None,
        None,
    ),
    (
        "ve_static_bfe",
        "FLD_ZONE = 'VE' AND STATIC_BFE > 0 AND V_DATUM = 'NAVD88' "
        "AND LEN_UNIT = 'Feet' AND DEPTH = -9999 "
        "AND STUDY_TYP = 'SFHA with BFE no floodway'",
        None,
        None,
    ),
    (
        "x_shaded",
        f"FLD_ZONE = 'X' AND ZONE_SUBTY = '0.2 PCT ANNUAL CHANCE FLOOD HAZARD' "
        f"AND STUDY_TYP = 'NP' AND {NO_BFE} AND {NO_DEPTH}",
        None,
        None,
    ),
    (
        "x_minimal",
        f"FLD_ZONE = 'X' AND ZONE_SUBTY = 'AREA OF MINIMAL FLOOD HAZARD' "
        f"AND STUDY_TYP = 'NP' AND {NO_BFE} AND {NO_DEPTH}",
        None,
        None,
    ),
    (
        "open_water",
        f"FLD_ZONE = 'OPEN WATER' AND STUDY_TYP = 'NP' AND {NO_BFE} AND {NO_DEPTH}",
        None,
        None,
    ),
    # Findings: published features the reference does not allow. The first three
    # hold legacy values (spec/legacy.json), so they validate with a warning.
    (
        "legacy_study_type",
        f"STUDY_TYP = 'SFHAs WITH LOW FLOOD RISK' AND {NO_BFE} AND {NO_DEPTH}",
        None,
        "STUDY_TYP",
    ),
    (
        "ascii_apostrophe_study_type",
        f"STUDY_TYP = 'Shaded Zone X with depths less than 1''' "
        f"AND {NO_BFE} AND {NO_DEPTH}",
        None,
        "STUDY_TYP",
    ),
    (
        "legacy_levee_subtype",
        "ZONE_SUBTY = 'AREA WITH REDUCED FLOOD RISK DUE TO LEVEE' "
        f"AND STUDY_TYP = 'NP' AND {NO_BFE} AND {NO_DEPTH}",
        None,
        "ZONE_SUBTY",
    ),
    (
        "uppercase_len_unit",
        "DFIRM_ID = '39057C' AND FLD_ZONE = 'AE' AND STATIC_BFE > 0 "
        "AND V_DATUM = 'NAVD88' AND LEN_UNIT = 'Feet' AND DEPTH = -9999",
        "LEN_UNIT",
        None,
    ),
    (
        "datum_without_bfe",
        f"V_DATUM = 'NAVD88' AND STATIC_BFE = -9999 AND {NO_DEPTH} "
        "AND STUDY_TYP = 'NP'",
        "@forbid_if(v_datum)",
        None,
    ),
    # Findings against the zone rules: Table 14 and SFHA_TF's description.
    (
        "ah_coastal_floodplain",
        "FLD_ZONE = 'AH' AND ZONE_SUBTY = 'COASTAL FLOODPLAIN'",
        "@forbid_if(zone_subty) [AH]",
        None,
    ),
    (
        "x_special_consideration",
        "FLD_ZONE = 'X' AND ZONE_SUBTY = 'AREA OF SPECIAL CONSIDERATION'",
        "@forbid_if(zone_subty) [X]",
        None,
    ),
    (
        "a99_without_subtype",
        "FLD_ZONE = 'A99' AND ZONE_SUBTY IS NULL AND STUDY_TYP = 'NP'",
        "@require_if(zone_subty) [A99, AR, X]",
        None,
    ),
    (
        "ae_outside_sfha",
        "FLD_ZONE = 'AE' AND SFHA_TF = 'F'",
        "@require_any_true(sfha_tf) [A, A99, AE, AH, AO, AR, V, VE]",
        None,
    ),
    (
        "x_inside_sfha",
        "FLD_ZONE = 'X' AND SFHA_TF = 'T'",
        "@require_any_true(sfha_tf) [D, X]",
        None,
    ),
]

# The cases with too few rows to be both small and NULL-clean.
SPARSE = {
    "x_special_consideration",
    "a99_without_subtype",
    "ae_outside_sfha",
    "x_inside_sfha",
}


def zone_filters(name: str) -> str:
    return RARE if name in SPARSE else f"{CLEAN} AND {SMALL}"


# Every required field populated and in its vocabulary, unless the case is about
# that field; `IS NULL` for the text ones, where the service writes no `""`.
BFE_FIELDS = {
    "ELEV": "ELEV <> -9999 AND ELEV IS NOT NULL",
    "V_DATUM": "V_DATUM NOT IN ('ASVD02', 'GUVD03', 'NAVD29')",
    "SOURCE_CIT": "SOURCE_CIT IS NOT NULL",
    "BFE_LN_ID": "BFE_LN_ID IS NOT NULL AND BFE_LN_ID <> ''",
}
BFE_CASES: list[Case] = [
    (
        "navd88_feet",
        "V_DATUM = 'NAVD88' AND LEN_UNIT = 'Feet' AND ELEV > 0",
        None,
        None,
    ),
    ("ngvd29", "V_DATUM = 'NGVD29' AND LEN_UNIT = 'Feet'", None, None),
    ("local_tidal_datum", "V_DATUM = 'LOCAL TIDAL DATUM'", None, None),
    ("meters", "LEN_UNIT = 'Meters'", None, None),
    # 3,021 rows; nothing in the reference says an elevation is positive.
    ("below_datum", "ELEV < 0 AND LEN_UNIT = 'Feet'", None, None),
    # Findings: published lines the reference does not allow.
    ("american_samoa_datum", "V_DATUM = 'ASVD02'", "V_DATUM", None),
    ("guam_2003_datum", "V_DATUM = 'GUVD03'", "V_DATUM", None),
    ("navd29_datum", "V_DATUM = 'NAVD29'", "V_DATUM", None),
    ("no_datum", "V_DATUM IS NULL", "V_DATUM", None),
    ("no_source_citation", "SOURCE_CIT IS NULL", "SOURCE_CIT", None),
    ("empty_line_id", "BFE_LN_ID = ''", "BFE_LN_ID", None),
]
# The findings with only a handful of rows, which may not be small.
# The one row without an ELEV also lacks BFE_LN_ID and SOURCE_CIT, so it makes
# no case: each case names one field.
BFE_SPARSE = {"navd29_datum", "no_datum", "empty_line_id"}


def clean_except_expected(
    fields: dict[str, str], cases: list[Case], sparse: set[str]
) -> Callable[[str], str]:
    """Filters holding every field of `fields` clean but the one a case expects
    to reject, and the features short unless the case is sparse."""

    def filters(name: str) -> str:
        expect = next(c[2] for c in cases if c[0] == name)
        clauses = [w for f, w in fields.items() if f != expect]
        if name not in sparse:
            clauses.append("SHAPE.STLength() < 0.01")
        return " AND ".join(clauses)

    return filters


# Every required field populated, every vocabulary value listed, and no letter
# on an unlettered section, unless the case is about that; a lone space in free
# text is a value, so `<> ''`, which also rejects one, is the strict side.
LETTER_RULE = "@forbid_if(xs_ltr)"
XS_FIELDS = {
    **{
        f: f"{f} IS NOT NULL AND {f} <> ''"
        for f in ("XS_LN_ID", "WTR_NM", "START_ID", "MODEL_ID", "LEN_UNIT")
    },
    "SOURCE_CIT": "SOURCE_CIT IS NOT NULL",
    "V_DATUM": "V_DATUM NOT IN ('ASVD02', 'GUVD03', 'NGVD88')",
    **{
        f: f"{f} <> -9999 AND {f} IS NOT NULL"
        for f in ("STREAM_STN", "WSEL_REG", "STRMBED_EL")
    },
    LETTER_RULE: "(XS_LN_TYP = 'LETTERED, MAPPED' OR XS_LTR IS NULL "
    "OR (XS_LTR = '' AND XS_LTR NOT LIKE ' '))",
}
UNLETTERED = "XS_LN_TYP = 'NOT LETTERED, MAPPED'"
XS_CASES: list[Case] = [
    (
        "lettered_navd88_feet",
        "XS_LN_TYP = 'LETTERED, MAPPED' AND XS_LTR <> '' "
        "AND V_DATUM = 'NAVD88' AND LEN_UNIT = 'Feet' AND STRMBED_EL > 0",
        None,
        None,
    ),
    ("unlettered", f"{UNLETTERED} AND XS_LTR IS NULL", None, None),
    ("ngvd29", "V_DATUM = 'NGVD29' AND LEN_UNIT = 'Feet'", None, None),
    ("meters", "LEN_UNIT = 'Meters'", None, None),
    # "For cross sections in the coastal floodplain, this value should be coded
    # '-8888'": "not populated", a value.
    ("coded_water_surface", "WSEL_REG = -8888", None, None),
    # 575,580 rows, 60% of the layer; the description names no such coding.
    ("coded_streambed", "STRMBED_EL = -8888", None, None),
    # 1,778 rows; the elevations' unit, and D_Length_Units lists it.
    ("miles", "LEN_UNIT = 'Miles'", None, None),
    # Findings: published cross sections the reference does not allow.
    (
        "letter_on_unlettered",
        f"{UNLETTERED} AND XS_LTR <> ''",
        LETTER_RULE,
        None,
    ),
    (
        "lone_space_letter_on_unlettered",
        f"{UNLETTERED} AND XS_LTR LIKE ' '",
        LETTER_RULE,
        None,
    ),
    ("american_samoa_datum", "V_DATUM = 'ASVD02'", "V_DATUM", None),
    ("ngvd88_datum", "V_DATUM = 'NGVD88'", "V_DATUM", None),
    ("no_source_citation", "SOURCE_CIT IS NULL", "SOURCE_CIT", None),
    ("no_station_start", "START_ID IS NULL", "START_ID", None),
    ("no_stream_station", "STREAM_STN = -9999", "STREAM_STN", None),
    ("no_water_surface", "WSEL_REG = -9999", "WSEL_REG", None),
    ("no_streambed", "STRMBED_EL = -9999", "STRMBED_EL", None),
    ("no_model_id", "MODEL_ID IS NULL", "MODEL_ID", None),
    ("no_water_name", "WTR_NM IS NULL", "WTR_NM", None),
]
XS_SPARSE = {"ngvd88_datum", "no_stream_station", "no_water_surface"}


FIXTURES_BY_LAYER = [
    Fixture(28, "flood_hazard_zones.json", ZONE_CASES, zone_filters),
    Fixture(
        16,
        "base_flood_elevations.json",
        BFE_CASES,
        clean_except_expected(BFE_FIELDS, BFE_CASES, BFE_SPARSE),
    ),
    Fixture(
        14,
        "cross_sections.json",
        XS_CASES,
        clean_except_expected(XS_FIELDS, XS_CASES, XS_SPARSE),
    ),
]


def query(layer: int, where: str) -> dict[str, Any]:
    params = {
        "where": where,
        "outFields": "*",
        "resultRecordCount": "1",
        "f": "geojson",
    }
    url = f"{SERVICE}/{layer}/query?{urllib.parse.urlencode(params)}"
    out = subprocess.run(
        ["curl", "-fsSL", "--max-time", "600", url], check=True, capture_output=True
    ).stdout
    payload: dict[str, Any] = json.loads(out)
    if "error" in payload:
        raise RuntimeError(f"{where}: {payload['error']}")
    return payload


def fetch_fixture(fixture: Fixture) -> bool:
    """Write `fixture`'s file; whether every case found a feature."""
    cases = []
    for name, where, expect, warns in fixture.cases:
        full = f"({where}) AND {fixture.filters(name)}"
        print(f"==> {name}")
        features = query(fixture.layer, full)["features"]
        if not features:
            print(f"    no feature matches; skipped: {full}", file=sys.stderr)
            continue
        cases.append(
            {
                "name": name,
                "where": full,
                "expect": expect,
                "warns": warns,
                "feature": features[0],
            }
        )
    payload = {
        "source": f"{SERVICE}/{fixture.layer}/query",
        "retrieved_at": dt.datetime.now(dt.UTC).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "cases": cases,
    }
    out = FIXTURES / fixture.out
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(payload, indent=2, ensure_ascii=False) + "\n")
    print(f"wrote {len(cases)} of {len(fixture.cases)} cases to {out}")
    return len(cases) == len(fixture.cases)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--layer", type=int, action="append", default=[], help="only these layers"
    )
    args = parser.parse_args()
    complete = [
        fetch_fixture(f)
        for f in FIXTURES_BY_LAYER
        if not args.layer or f.layer in args.layer
    ]
    return 0 if all(complete) else 1


if __name__ == "__main__":
    sys.exit(main())
