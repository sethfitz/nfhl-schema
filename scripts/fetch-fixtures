# The reference's; the legacy ones validate with a warning, so a case that is not
# about one leaves them out.
LEVEE_STATUSES = [
    "Accredited",
    "Non-Accredited",
    "Provisionally Accredited",
    "AR",
    "A99",
    "NP",
]
LEVEE_ANALYSES = [
    "Natural Valley",
    "Structural-Based Inundation",
    "Overtopping",
    "Freeboard Deficient",
    "Sound Reach",
    "BFE Below Toe",
    "Not Hydraulically Significant",
    "Other",
    "NP",
]
LENGTH_UNITS = [
    "Centimeters",
    "Feet",
    "Inches",
    "Kilometers",
    "Meters",
    "Miles",
    "Millimeters",
    "U.S. Survey Feet",
    "NP",
]
LEVEE_RULES = {
    "@forbid_if(lev_an_typ)": "NOT (LEV_AN_TYP IS NOT NULL AND LEV_AN_TYP <> '' "
    "AND LEV_AN_TYP <> 'NP' AND (LEVEE_STAT IS NULL OR LEVEE_STAT = '' "
    "OR LEVEE_STAT <> 'Non-Accredited'))",
    "@require_if(district)": f"NOT (USACE_LEV = 'T' AND {missing('DISTRICT')})",
}
# The service compares case-insensitively, so every `IN` below also matches a
# value in the wrong case. These four levees hold one, which the model rejects
# (`KANSAS CITY`, `LEVEE CENTERLINE`, `NON-ACCREDITED` twice) and no `where` can
# find by value; they are pinned by LEVEE_ID, and kept out of every other case.
WRONG_CASE = {
    "DISTRICT": "LEVEE_ID <> '20079C_1'",
    "LEVEE_TYP": "LEVEE_ID <> '38055C_1'",
    "LEVEE_STAT": "LEVEE_ID NOT IN ('1505901512', '1505000990')",
}
# Every required field populated, every vocabulary value listed, and no rule
# broken, unless the case is about that; a lone space in free text is a value.
# `FC_SEG_ID` is required, and 13,405 of 16,320 levees lack it, so every other
# case names one that has it.
LEVEE_FIELDS = {
    **{
        f: f"NOT {missing(f)}"
        for f in (
            "DFIRM_ID",
            "VERSION_ID",
            "LEVEE_ID",
            "FC_SYS_ID",
            "FC_SEG_ID",
            "SOURCE_CIT",
        )
    },
    "LEVEE_TYP": f"({missing('LEVEE_TYP')} OR LEVEE_TYP IN "
    f"({sql_list(LEVEE_TYPES)})) AND {WRONG_CASE['LEVEE_TYP']}",
    **{
        f: f"({missing(f)} OR {f} IN ('T', 'F', 'U'))"
        for f in ("USACE_LEV", "PL84_99TF")
    },
    "DISTRICT": "(DISTRICT IS NULL OR DISTRICT NOT LIKE ' ') "
    f"AND DISTRICT <> '1027' AND {WRONG_CASE['DISTRICT']}",
    "LEVEE_STAT": f"({missing('LEVEE_STAT')} OR LEVEE_STAT IN "
    f"({sql_list(LEVEE_STATUSES)})) AND {WRONG_CASE['LEVEE_STAT']}",
    "LEV_AN_TYP": f"({missing('LEV_AN_TYP')} OR LEV_AN_TYP IN "
    f"({sql_list(LEVEE_ANALYSES)}))",
    "LEN_UNIT": f"({missing('LEN_UNIT')} OR LEN_UNIT IN ({sql_list(LENGTH_UNITS)}))",
    **LEVEE_RULES,
}
# Section 7.3's non-populated date is 8/8/8888 and its null date 9/9/9999.
NOT_POPULATED_DATE = "timestamp '8888-08-08 00:00:00'"
LEVEE_CASES: list[Case] = [
    (
