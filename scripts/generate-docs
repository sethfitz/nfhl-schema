#!/usr/bin/env bash
# Regenerate docs/ -- Markdown reference pages for the models -- with Overture's own
# generator, `overture-codegen generate --format markdown`.
#
#   scripts/generate-docs [--into DIR]
#
# Every file in docs/ is rewritten, so docs/ is a build artifact like src/nfhl/models/;
# `tests/test_docs.py` fails if the committed pages differ from a fresh generation.
# `--into DIR` writes elsewhere. The pages are committed as an example of what the
# models produce, and to read the references' values in a human-readable form.
set -euo pipefail

main() {
  local root out
  root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  out="$root/docs"
  case "${1:-}" in
    "") ;;
    --into) [ $# -eq 2 ] || { echo "usage: $0 [--into DIR]" >&2; exit 2; }; out="$2" ;;
    *) echo "usage: $0 [--into DIR]" >&2; exit 2 ;;
  esac
  rm -rf "$out"
  uv run --project "$root" overture-codegen generate --format markdown --tag nfhl --output-dir "$out"
  find "$out" -type f | sort | sed 's/^/wrote /'
}

main "$@"; exit $?
